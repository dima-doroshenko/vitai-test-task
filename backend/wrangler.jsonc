{
  "name": "kvarta-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": false
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "TELEGRAM_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kvarta-leads",
      "database_id": "e0164100-0f4d-4a6e-95b3-7095555fb378",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "kvarta-api-preview",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "preview",
        "TELEGRAM_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kvarta-leads-preview",
          "database_id": "d1f5cd12-f965-433e-8b4e-a0313c76e4c1",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
